# ============================================================================
# Không còn SQL Server trong Docker. Database là PostgreSQL:
#   - Neon (khuyên dùng, dùng chung được cho local, demo và Render), hoặc
#   - PostgreSQL cài trên máy (xem deploy/postgres/create-databases.sql).
# File .env Ở GỐC REPO KHÔNG CÒN CẦN. Mỗi service có .env RIÊNG trong thư mục của nó.
# Không được lặp lại một tên biến trong cùng một file .env (dotenv sẽ báo "Duplicate key").
#
# Ví dụ user-service/.env (Neon, dùng host KHÔNG có "-pooler"):
#   DB_URL=jdbc:postgresql://ep-xxxx.ap-southeast-1.aws.neon.tech/music4_user?sslmode=require
#   DB_USERNAME=neondb_owner
#   DB_PASSWORD=<mật khẩu Neon>
#
# Ví dụ PostgreSQL trên máy:
#   DB_URL=jdbc:postgresql://localhost:5432/music4_user
#   DB_USERNAME=postgres
#   DB_PASSWORD=<mật khẩu postgres>
#
# DB lần lượt: music4_user, music4_content, music4_engagement, music4_analytics, music4_media
