# ============================================================================
# Music4 – biến môi trường. Mỗi service có .env riêng (spring-dotenv đọc file .env
# trong thư mục service). KHÔNG commit .env thật. Giá trị dưới đây chỉ là ví dụ.
# ============================================================================

# ---- Dùng chung cho MỌI service Java -------------------------------------
EUREKA_SERVER_URL=http://localhost:8761/eureka
CONFIG_SERVER_URL=http://localhost:8888
RABBITMQ_ADDRESSES=amqp://guest:guest@localhost:5672
# Gateway gắn header này; service từ chối request không có (để trống = tắt, chỉ dùng khi test Swagger trực tiếp)
GATEWAY_SECRET=doi-chuoi-ngau-nhien-dai
# Header X-Internal-Token cho API /internal/** giữa các service (GIỐNG NHAU ở mọi service)
INTERNAL_TOKEN=doi-chuoi-ngau-nhien-khac

# ---- api-gateway (8080) ----------------------------------------------------
# JWT_SECRET: Base64 >= 32 byte, GIỐNG user-service. Tạo: openssl rand -base64 48
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://*.vercel.app

# ---- SQL Server trong Docker (docker-compose.db.yml) -------------------------
MSSQL_SA_PASSWORD=Music4@Sa2026
# Mật khẩu chung cho 5 login service (music4_user_svc, music4_content_svc, ...)
DB_SERVICE_PASSWORD=Music4@Svc2026

# ---- user-service (8081) ---------------------------------------------------
# Trong Docker network đổi localhost -> sqlserver
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=Music4_User;encrypt=true;trustServerCertificate=true
DB_USERNAME=music4_user_svc
DB_PASSWORD=Music4@Svc2026
JWT_SECRET=
JWT_EXPIRATION=3600000
JWT_REFRESH_DAYS=7
MAIL_USERNAME=
MAIL_PASSWORD=
FRONTEND_URL=http://localhost:5173

# ---- content-service (8082) / engagement (8083) / analytics (8084) / media (8085)
# DB lần lượt: Music4_Content, Music4_Engagement, Music4_Analytics, Music4_Media
# DB_USERNAME lần lượt: music4_content_svc, music4_engagement_svc, music4_analytics_svc, music4_media_svc
# Azure SQL (production): jdbc:sqlserver://<server>.database.windows.net:1433;database=Music4_User;encrypt=true;trustServerCertificate=false;loginTimeout=60

# ---- media-service (8085) --------------------------------------------------
ACCESS_KEY=
SECRET_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=

# ---- search-admin-service (8086) -------------------------------------------
ELASTICSEARCH_URL=http://localhost:9200
AI_SERVICE_URL=http://localhost:8000
AI_API_KEY=

# ---- AI-service (8000, Python) ---------------------------------------------
AI_API_KEY=
EUREKA_ENABLED=true
INSTANCE_HOST=localhost

# ---- Profile render (không có Eureka/Config Server) -------------------------
# EUREKA_ENABLED=false
# USER_SERVICE_URL=https://music4-user.onrender.com   (dùng cho Feign)
# USER_SERVICE_URI=https://music4-user.onrender.com   (dùng cho route gateway)
# ... tương tự CONTENT_, ENGAGEMENT_, ANALYTICS_, MEDIA_, SEARCH_ADMIN_
