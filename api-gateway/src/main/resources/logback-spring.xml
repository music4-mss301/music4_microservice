<?xml version="1.0" encoding="UTF-8"?>
<!--
  Log ra console như bình thường. Khi chạy với profile "elk" (docker-compose đặt sẵn) thì GỬI THÊM log dạng JSON
  tới Logstash (cổng 5000) -> Elasticsearch -> Kibana. Chạy trong IntelliJ không có profile này nên không gửi gì.
  Muốn gửi log từ IntelliJ: đặt SPRING_PROFILES_ACTIVE=elk và LOGSTASH_HOST=localhost.
  Mỗi dòng log mang theo: service, level, logger, message, stack_trace và traceId/spanId (nếu có tracing).
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="app"/>

    <springProfile name="elk">
        <appender name="LOGSTASH" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
            <destination>${LOGSTASH_HOST:-logstash}:${LOGSTASH_PORT:-5000}</destination>
            <reconnectionDelay>5 seconds</reconnectionDelay>
            <keepAliveDuration>5 minutes</keepAliveDuration>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"service":"${appName}"}</customFields>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="LOGSTASH"/>
        </root>
    </springProfile>

    <springProfile name="!elk">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
